# =============================================================================
# KimiFun Backend Environment Configuration
# =============================================================================

# 1. Environment Mode ('development' | 'production' | 'testing')
ENVIRONMENT=development

# 2. Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/KimiFun_db

# 3. JWT Authentication & Security
SECRET_KEY=KimiFun-insecure-development-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. AI Provider Active Selector
# Pilih salah satu: '9router' atau 'gemini'
AI_PROVIDER=9router

# =============================================================================
# OPSI 1: 9router (OpenAI-compatible Gateway)
# =============================================================================
# API Key dari 9router dashboard
NINE_ROUTER_API_KEY=your_9router_api_key_here
# Base URL endpoint 9router (akhiri dengan /v1)
NINE_ROUTER_BASE_URL=https://api.9router.com/v1
# Model ID yang didukung 9router (cth: ag/gemini-1.5-flash, openai/gpt-4o-mini, dll)
NINE_ROUTER_MODEL=ag/gemini-1.5-flash

# =============================================================================
# OPSI 2: Google Gemini API Langsung (Gratis via Google AI Studio)
# =============================================================================
# Dapatkan di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
