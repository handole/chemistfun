# =============================================================================
# KimiFun Environment Variables
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=KimiFun_db
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8000
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# CORS Origins (Comma-separated for explicit domain/IP)
# Masukkan origin frontend, domain Tailscale Funnel (HTTPS), atau IP Tailscale (100.x.x.x)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-node.tailnet-xyz.ts.net

# CORS Origin Regex (Regex pattern auto-matching Tailscale Funnel and Tailscale IP)
# Mendukung otomatis semua domain *.ts.net dan IP Tailscale 100.x.x.x
CORS_ORIGIN_REGEX=^https://.*\.ts\.net(:\d+)?$|^http://100\.\d{1,3}\.\d{1,3}\.\d{1,3}(:\d+)?$

# AI Service Settings
AI_PROVIDER=9router
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=https://api.9router.com/v1
NINE_ROUTER_MODEL=ag/gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend Configuration (Reserved for future Vue.js setup)
FRONTEND_PORT=5173

